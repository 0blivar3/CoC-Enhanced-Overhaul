-- Кеширование глобальных функций и синглтонов для Lua 5.1 (ускорение вызовов)
local math_random = math.random
local system_ini   = system_ini
local alife        = alife
local pairs        = pairs
local tonumber     = tonumber

-- Таблицы для кэширования данных (вычитываются один раз за сессию)
local item_by_community = {}
local mul_by_level      = {}
local count_by_level    = {}

local death_ini = ini_file("misc\\ph_box_generic.ltx")
local sys_ini   = system_ini()

ph_item_box_manager = nil

function get_box_manager()
	if not ph_item_box_manager then 
		ph_item_box_manager = ph_item_box()
	end 
	return ph_item_box_manager
end 

class "ph_item_box"

function ph_item_box:__init()
	-- Однократная инициализация базовых списков предметов по типам ящиков
	local community_list = { 
		"def_box", "small_box_generic", "small_box_ussr", "small_box_nato", 
		"small_box_army", "small_box_science", "big_box_generic", "big_box_dungeons", "big_box_arsenal"
	}
	
	for _, v in pairs(community_list) do
		item_by_community[v] = {}
		if death_ini:section_exist(v) then
			local n = death_ini:line_count(v)
			for i = 0, n - 1 do
				local result, id, value = death_ini:r_line(v, i, "", "")
				if id and id ~= "" then
					item_by_community[v][id] = tonumber(value) or 0
				end
			end
		end
	end

	-- Кеширование коэффициентов выпадения для текущего уровня
	local level_name = level.name()

	if death_ini:section_exist(level_name) then
		local n = death_ini:line_count(level_name)
		for i = 0, n - 1 do
			local result, id, value = death_ini:r_line(level_name, i, "", "")
			if id and id ~= "" then
				mul_by_level[id] = tonumber(value) or 0
			end
		end
	end

	-- Кеширование количества предметов для текущего уровня
	local level_count_section = level_name .. "_count"
	if death_ini:section_exist(level_count_section) then
		local n = death_ini:line_count(level_count_section)
		for i = 0, n - 1 do
			local result, id, value = death_ini:r_line(level_count_section, i, "", "")
			if id and id ~= "" then
				local p = string.find(value, ",")
				if p then
					count_by_level[id] = {
						min = tonumber(string.sub(value, 1, p - 1)) or 0,
						max = tonumber(string.sub(value, p + 1)) or 0
					}
				end
			end
		end
	end
end

function ph_item_box:spawn_items(obj, who, spawn_ini)
	if not obj then return end

	-- 1. Сначала спавним обязательные предметы, если они прописаны в кастомной логике ящика
	create_obligatory_items(obj, spawn_ini)

	-- 2. Определяем комьюнити (тип) ящика
	local community = "def_box"
	if spawn_ini and spawn_ini:section_exist("drop_box") and spawn_ini:line_exist("drop_box", "community") then
		community = spawn_ini:r_string("drop_box", "community") or "def_box"
	else
		-- Попытка прочесть из спавн-секций самого объекта
		local obj_ini = obj:spawn_ini()
		if obj_ini and obj_ini:section_exist("drop_box") and obj_ini:line_exist("drop_box", "community") then
			community = obj_ini:r_string("drop_box", "community") or "def_box"
		end
	end

	local items_table = item_by_community[community]
	if not items_table then 
		items_table = item_by_community["def_box"]
	end

	if not items_table then return end

	-- Предотвращаем спавн, если для этого типа ящиков все отключено
	if items_table == 0 then return end

	-- 3. Вычисляем и спавним случайный лут
	for section, probability in pairs(items_table) do
		if probability > 0 then
			-- Коэффициент вероятности для конкретного уровня
			local r_mul = mul_by_level[section] or mul_by_level["box_mult"] or 1
			local final_prob = probability * r_mul

			-- Определение количества предметов
			local min_cnt, max_cnt = 0, 0
			local count_data = count_by_level[section] or count_by_level["box_count"]
			
			if count_data then
				min_cnt = count_data.min
				max_cnt = count_data.max
			end

			local num = min_cnt
			if max_cnt > min_cnt then
				num = math_random(min_cnt, max_cnt)
			end

			if num > 0 then
				create_items(obj, section, num, final_prob)
			end
		end
	end
end

function create_items(obj, section, number, rnd)
	if not (sys_ini:section_exist(section) and sys_ini:line_exist(section, "cform")) then 
		return 
	end

	local pos = vector():set(obj:position())
	pos.y = pos.y + 0.1 -- Небольшое смещение вверх, чтобы вещь не проваливалась под текстуры пола

	local lvid = obj:level_vertex_id()
	local gvid = obj:game_vertex_id()
	local sim = alife()

	if not sim then return end

	if utils.is_ammo(section) then
		if math_random() <= rnd then
			if number > 0 then
				create_ammo(section, pos, lvid, gvid, 65535, number)
			end
		end
	else
		for i = 1, number do
			if math_random() <= rnd then
				sim:create(section, pos, lvid, gvid)
			end
		end
	end
end

function create_obligatory_items(obj, spawn_ini)
	if not (spawn_ini and spawn_ini:section_exist("drop_box") and spawn_ini:line_exist("drop_box", "items")) then
		return
	end
	
	local items_string = spawn_ini:r_string("drop_box", "items")
	if not items_string or items_string == "" then return end
	
	local sim = alife()
	if not sim then return end

	local pos = vector():set(obj:position())
	pos.y = pos.y + 0.1
	local lvid = obj:level_vertex_id()
	local gvid = obj:game_vertex_id()

	-- Парсим строку вида "section1, count1, section2, count2"
	for item_data in string.gmatch(items_string, "([^,]+)") do
		local section = string.trim(item_data)
		if section and section ~= "" and sys_ini:section_exist(section) then
			sim:create(section, pos, lvid, gvid)
		end
	end
end