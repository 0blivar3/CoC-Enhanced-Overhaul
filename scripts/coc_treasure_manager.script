-- ============================================================
--
-- coc_treasure_manager.script
--	CoC 1.4.19 - DoctorX Questlines 1.19
--
--	Original: Alundaio
--	Modified by: DoctorX
--	Stash content rework: themed stashes, value tiers, level profiles
--
-- ============================================================


--[[
------------------------------------------------------------------------------------------------------------------
-- Treasure randomizer (reworked)
-- original by Alundaio
------------------------------------------------------------------------------------------------------------------
This script spawns loot, randomly, inside all INVBOX class objects. Loot is determined on new game start and stored
within the .scoc as a string. When the cache is opened, the loot is spawned.

HOW A STASH IS GENERATED
1. The level where the box stands gives a profile (LEVEL_PROFILE): a value multiplier and a bias towards some themes.
2. A THEME is chosen (scavenger, medic, hunter, stalker, scientist, military, bandit, mixed). It defines which
   item categories the stash is made of.
3. A TIER is rolled (poor / common / good / rich / jackpot). It defines the loot budget, the price cap of a single
   item and the condition range of weapons/outfits. Jackpot is ~2%.
4. From tier "common" up the stash gets one "highlight" item - something noticeably valuable for its tier.
5. The rest of the budget is filled with items. Same section is never picked twice, there are limits per category
   (1 weapon, 1 outfit, 1 helmet, ...), so a stash never turns into a walking arsenal.
6. Every weapon comes with 1 box of ammo that fits it. Small chance of a personal "flavor" item (guitar, PDA, ...).

Item categories are detected automatically from system_ini() (class / section name), so modded items that are
valid (see below) are picked up automatically.

A valid item section is determined by several factors:
1. It must have can_trade = true
2. It must have quest_item = false
3. It must not have 'mp_' in it's section name
4. It must have a valid 'inv_name' value
5. 'cost' must be greater than 0
If you do not want a certain section to be spawned, put it in 'plugins\coc_treasure_manager.ltx' 'ignore_sections'.

STORED FORMAT (string in caches[id], comma separated entries):
	section              - one item
	section:N            - N copies of an item, or N rounds for ammo
	section#C            - item with condition C percent (weapons, outfits, helmets)
	section:N#C          - both
Old saves with plain "section,section" strings still work.

To debug, enable DEV_DEBUG (-dbg in command line). Every generated stash is printed to the log with its theme and tier.
You can also inspect the savegame .lua and search for 'caches'.

TUNING: everything is in the CONFIG block right below. If your price list is modded, scale the tier min/max/cap.
--]]

caches = {}
local caches_count = 0

local ltx = ini_file("plugins\\coc_treasure_manager.ltx")
local valid_item_list = nil
local item_pools = nil

------------------------------------------------------------------------------------------------------------------
--							CONFIG
------------------------------------------------------------------------------------------------------------------
local MIN_ITEM_COST = 50		-- stop filling when the remaining budget is lower than this
local MAX_PICK_TRIES = 30		-- max attempts to add an item
local MAX_PICK_FAILS = 8		-- stop after this many failed attempts
local MAX_ITEMS = 14			-- max number of main items in one stash (companion ammo is not counted)
local FLAVOR_CHANCE = 12		-- % chance of a personal flavor item
local FLAVOR_ITEMS = {"guitar_a","harmonica_a","itm_pda_common","vodka","energy_drink","kolbasa"}

-- upto: cumulative roll border (1-100). min/max: budget range (in item cost units). cap: max cost of a single item.
-- cond_min/cond_max: condition (%) of found weapons / outfits / helmets
local TIERS = {
	{name="poor",    upto=40,  min=700,   max=2200,  cap=2000,  cond_min=25, cond_max=60},
	{name="common",  upto=73,  min=2200,  max=5500,  cap=5000,  cond_min=40, cond_max=80},
	{name="good",    upto=90,  min=5500,  max=12000, cap=11000, cond_min=55, cond_max=95},
	{name="rich",    upto=98,  min=12000, max=24000, cap=24000, cond_min=70, cond_max=100},
	{name="jackpot", upto=100, min=24000, max=42000, cap=50000, cond_min=80, cond_max=100},
}

-- Themes. cats = category weights. weapons = max weapons, art = max artifacts,
-- extra_weapon = +1 weapon from tier "good" up, mult = budget multiplier.
local THEMES = {
	{id="scavenger", weight=18, mult=0.85,
		cats={food=38, medicine=16, tool=12, misc=12, ammo=14, grenade=4, weapon=4}},
	{id="medic", weight=11, mult=0.95,
		cats={medicine=58, food=14, tool=10, ammo=6, misc=6, detector=3, grenade=3}},
	{id="hunter", weight=13, mult=1.0, extra_weapon=1,
		cats={weapon=30, ammo=30, attach=12, grenade=8, tool=12, food=5, medicine=3}},
	{id="stalker", weight=11, mult=1.0,
		cats={outfit=22, helmet=18, tool=22, medicine=12, food=8, detector=8, weapon=5, ammo=5}},
	{id="scientist", weight=8, mult=1.05, art=2,
		cats={artifact=30, detector=18, pda=14, medicine=14, tool=8, misc=6, food=5, ammo=3}},
	{id="military", weight=9, mult=1.1, extra_weapon=1,
		cats={weapon=24, ammo=28, grenade=18, medicine=10, helmet=8, outfit=6, food=6}},
	{id="bandit", weight=12, mult=0.95,
		cats={weapon=16, ammo=20, food=22, medicine=8, grenade=8, misc=14, pda=4, artifact=3}},
	{id="mixed", weight=18, mult=1.0,
		cats={food=12, medicine=12, ammo=12, weapon=10, grenade=6, tool=8, outfit=6, helmet=5, artifact=6,
			detector=4, pda=4, attach=4, misc=6}},
}

-- Level profiles: mult = value multiplier (dangerous/deep zones are richer), bias = theme weight multipliers.
-- Unknown levels use DEFAULT_PROFILE.
local DEFAULT_PROFILE = {mult=1.0, bias={}}
local LEVEL_PROFILE = {
	l01_escape          = {mult=0.80, bias={scavenger=1.5, bandit=1.2}},
	k00_marsh           = {mult=0.85, bias={scavenger=1.4, hunter=1.2}},
	zaton               = {mult=0.90, bias={scavenger=1.3, hunter=1.2}},
	l02_garbage         = {mult=0.90, bias={bandit=1.6, scavenger=1.2}},
	l03_agroprom        = {mult=1.00, bias={military=1.3, bandit=1.2}},
	l03u_agr_underground= {mult=1.15, bias={scientist=1.5, military=1.2}},
	l04_darkvalley      = {mult=1.00, bias={bandit=1.8}},
	l04u_labx18         = {mult=1.30, bias={scientist=2.5, medic=1.3}},
	l05_bar             = {mult=0.90, bias={stalker=1.4, medic=1.2}},
	l06_rostok          = {mult=1.00, bias={bandit=1.3, military=1.2}},
	jupiter             = {mult=1.05, bias={scavenger=1.2, scientist=1.2}},
	jupiter_underground = {mult=1.20, bias={scientist=1.5}},
	l07_military        = {mult=1.15, bias={military=2.5}},
	k01_darkscape       = {mult=1.05, bias={military=1.5, bandit=1.3}},
	l08_yantar          = {mult=1.10, bias={scientist=2.5}},
	l08u_brainlab       = {mult=1.35, bias={scientist=3.0}},
	l09_deadcity        = {mult=1.15, bias={bandit=1.5}},
	l10_radar           = {mult=1.25, bias={military=1.8}},
	l10_red_forest      = {mult=1.20, bias={scientist=1.4, hunter=1.3}},
	l10u_bunker         = {mult=1.35, bias={military=1.8, scientist=1.5}},
	l11_pripyat         = {mult=1.25, bias={military=1.5, stalker=1.3}},
	pripyat             = {mult=1.25, bias={military=1.5, stalker=1.3}},
	l12_stancia         = {mult=1.35, bias={military=1.6, scientist=1.6}},
	l12_stancia_2       = {mult=1.35, bias={military=1.6, scientist=1.6}},
	labx8               = {mult=1.35, bias={scientist=3.0}},
}

local STACKABLE = {food=true, medicine=true, grenade=true, tool=true, misc=true}
local CONDITION_CATS = {weapon=true, outfit=true, helmet=true}

------------------------------------------------------------------------------------------------------------------
--							PRIVATE: classification and picking
------------------------------------------------------------------------------------------------------------------
local function classify(sec, ini)
	local cls = ini:r_string_ex(sec,"class","") or ""

	if (utils.is_ammo(sec)) then
		return "ammo"
	end

	if (string.find(sec,"pda",1,true) or cls == "D_PDA") then
		return "pda"
	end

	if (string.find(cls,"W_SCOPE",1,true) or string.find(cls,"W_SILENC",1,true) or string.find(cls,"W_GLAUNC",1,true)
	or string.find(sec,"^wpn_addon_")) then
		return "attach"
	end

	if (string.find(cls,"WP_",1,true)) then
		if (string.find(cls,"BINOC",1,true)) then
			return nil
		end
		if (string.find(cls,"KNIFE",1,true)) then
			return "misc"
		end
		return "weapon"
	end

	if (string.find(sec,"^grenade_") or string.find(cls,"^G_")) then
		return "grenade"
	end

	if (string.find(cls,"STLK",1,true)) then
		return "outfit"
	end

	if (string.find(cls,"HLMET",1,true)) then
		return "helmet"
	end

	if (string.find(cls,"ARTE",1,true) or string.find(sec,"^af_")) then
		return "artifact"
	end

	if (string.find(sec,"^detector_") or string.find(cls,"^D_")) then
		return "detector"
	end

	if (string.find(sec,"^medkit") or string.find(sec,"^bandage") or string.find(sec,"^drug_")
	or string.find(sec,"^antirad") or string.find(sec,"^stimpack")
	or string.find(cls,"MEDKI",1,true) or string.find(cls,"BANDG",1,true) or string.find(cls,"ANTIR",1,true)) then
		return "medicine"
	end

	if (string.find(cls,"FOOD",1,true)) then
		return "food"
	end

	if (string.find(sec,"^itm_")) then
		return "tool"
	end

	return "misc"
end

local function build_pools()
	local ini = system_ini()
	local pools = {}
	for sec,cost in pairs(valid_item_list) do
		local cat = classify(sec,ini)
		if (cat) then
			if not (pools[cat]) then
				pools[cat] = {}
			end
			local p = pools[cat]
			p[#p+1] = {sec=sec, cost=cost}
		end
	end
	return pools
end

-- cheaper items are more common; items close to the tier cap are favored over junk
local function item_weight(cost, cap)
	return (1/(1+cost/1500)) * (0.25 + cost/cap)
end

local function pick_item(pool, cap, budget, used, lo)
	if not (pool) then
		return nil
	end

	local top = math.min(cap,budget)
	local total = 0
	for i=1,#pool do
		local p = pool[i]
		if (p.cost <= top and p.cost >= lo and not used[p.sec]) then
			total = total + item_weight(p.cost,cap)
		end
	end

	if (total <= 0) then
		return nil
	end

	local r = math.random() * total
	local last
	for i=1,#pool do
		local p = pool[i]
		if (p.cost <= top and p.cost >= lo and not used[p.sec]) then
			last = p
			r = r - item_weight(p.cost,cap)
			if (r <= 0) then
				return p
			end
		end
	end
	return last
end

local function pick_category(cats, counts, limits)
	local total = 0
	for cat,w in pairs(cats) do
		if (item_pools[cat] and (counts[cat] or 0) < (limits[cat] or 99)) then
			total = total + w
		end
	end

	if (total <= 0) then
		return nil
	end

	local r = math.random() * total
	local last
	for cat,w in pairs(cats) do
		if (item_pools[cat] and (counts[cat] or 0) < (limits[cat] or 99)) then
			last = cat
			r = r - w
			if (r <= 0) then
				return cat
			end
		end
	end
	return last
end

local function pick_theme(profile)
	local total = 0
	for i=1,#THEMES do
		total = total + THEMES[i].weight * (profile.bias[THEMES[i].id] or 1)
	end

	local r = math.random() * total
	for i=1,#THEMES do
		r = r - THEMES[i].weight * (profile.bias[THEMES[i].id] or 1)
		if (r <= 0) then
			return THEMES[i]
		end
	end
	return THEMES[#THEMES]
end

local function pick_tier(luck)
	local r = math.random(100) + math.floor((luck or 0) * 3)
	for i=1,#TIERS do
		if (r <= TIERS[i].upto) then
			return TIERS[i], i
		end
	end
	return TIERS[#TIERS], #TIERS
end

local function get_level_name(se_box)
	local ok, name = pcall(function()
		return alife():level_name(game_graph():vertex(se_box.m_game_vertex_id):level_id())
	end)
	if (ok) then
		return name
	end
	return nil
end

local function ammo_box_size(sec, ini)
	local box = ini:r_float_ex(sec,"box_size") or 30
	return math.max(1,math.floor(box))
end

local function make_entry(sec, qty, cond, force_count)
	local s = sec
	if (qty and (qty > 1 or force_count)) then
		s = s .. ":" .. tostring(qty)
	end
	if (cond) then
		s = s .. "#" .. tostring(cond)
	end
	return s
end

local function parse_entry(s)
	local base, count, cond = s, nil, nil

	local p = string.find(base,"#",1,true)
	if (p) then
		cond = tonumber(string.sub(base,p+1))
		base = string.sub(base,1,p-1)
	end

	p = string.find(base,":",1,true)
	if (p) then
		count = tonumber(string.sub(base,p+1))
		base = string.sub(base,1,p-1)
	end

	return base, count, cond
end

------------------------------------------------------------------------------------------------------------------
--							PRIVATE: loot generation
------------------------------------------------------------------------------------------------------------------
-- Returns array of entry strings, theme and tier. Does not spawn anything.
local function generate_loot(se_box, luck, bonus_items)
	if not (valid_item_list) then
		valid_item_list = get_valid_item_sections()
	end

	if not (item_pools) then
		item_pools = build_pools()
	end

	local ini = system_ini()
	local lname = get_level_name(se_box)
	local profile = LEVEL_PROFILE[lname] or DEFAULT_PROFILE
	local theme = pick_theme(profile)

	if (has_alife_info("achieved_rag_and_bone")) then
		luck = (luck or 0) + 2
	end
	local tier, tier_idx = pick_tier(luck)

	local budget = math.random(tier.min,tier.max) * profile.mult * theme.mult
	local cap = tier.cap * profile.mult

	local entries = {}
	local used = {}
	local counts = {}
	local n_items = 0

	local limits = {
		weapon = theme.weapons or 1,
		outfit = 1,
		helmet = 1,
		artifact = theme.art or 1,
		detector = 1,
		pda = 1,
		attach = 2,
		ammo = 3,
		grenade = 3,
		tool = 3,
		misc = 2,
		food = 5,
		medicine = 5,
	}
	if (tier_idx >= 3 and theme.extra_weapon) then
		limits.weapon = limits.weapon + theme.extra_weapon
	end
	if (tier_idx >= 4) then
		limits.artifact = limits.artifact + 1
	end

	-- items requested by the caller (quests etc.) are always added
	if (bonus_items) then
		for i=1,#bonus_items do
			local sec = bonus_items[i]
			if (sec and sec ~= "") then
				entries[#entries+1] = sec
				used[sec] = true
			end
		end
	end

	local function add_companion_ammo(sec)
		local ammos = alun_utils.parse_list(ini,sec,"ammo_class")
		if not (ammos and #ammos > 0) then
			return
		end

		local good = {}
		for i=1,#ammos do
			local a = ammos[i]
			if (ini:section_exist(a) and not used[a] and utils.is_ammo(a)) then
				good[#good+1] = a
			end
		end

		if (#good > 0) then
			local a = good[math.random(#good)]
			local box = ammo_box_size(a,ini)
			local rounds = math.random(box,box*2)
			used[a] = true
			entries[#entries+1] = make_entry(a,rounds,nil,true)
			budget = budget - (ini:r_float_ex(a,"cost") or 0) * rounds / box
		end
	end

	local function try_add(cat, lo)
		if ((counts[cat] or 0) >= (limits[cat] or 99)) then
			return false
		end

		local p = pick_item(item_pools[cat],cap,budget,used,lo)
		if not (p) then
			return false
		end

		local sec, cost = p.sec, p.cost
		used[sec] = true
		counts[cat] = (counts[cat] or 0) + 1

		local qty, spent, cond, force = 1, cost, nil, false

		if (cat == "ammo") then
			local box = ammo_box_size(sec,ini)
			qty = math.random(math.max(1,math.floor(box*0.5)),math.max(1,math.floor(box*1.5)))
			spent = cost * qty / box
			force = true
		elseif (STACKABLE[cat]) then
			local mx = (cost <= 300 and 4) or (cost <= 1000 and 2) or 1
			qty = math.random(1,mx)
			while (qty > 1 and cost * qty > budget) do
				qty = qty - 1
			end
			spent = cost * qty
		end

		if (CONDITION_CATS[cat]) then
			cond = math.random(tier.cond_min,tier.cond_max)
		end

		entries[#entries+1] = make_entry(sec,qty,cond,force)
		budget = budget - spent
		n_items = n_items + 1

		if (cat == "weapon") then
			add_companion_ammo(sec)
		end

		return true
	end

	-- highlight item: something that makes the stash worth the trip for its tier
	if (tier_idx >= 2) then
		for attempt=1,6 do
			local cat = pick_category(theme.cats,counts,limits)
			if not (cat) then
				break
			end
			if (try_add(cat,cap*0.3)) then
				break
			end
		end
	end

	-- fill the rest
	local tries, fails = 0, 0
	while (budget >= MIN_ITEM_COST and tries < MAX_PICK_TRIES and fails < MAX_PICK_FAILS and n_items < MAX_ITEMS) do
		tries = tries + 1
		local cat = pick_category(theme.cats,counts,limits)
		if not (cat) then
			break
		end
		if not (try_add(cat,0)) then
			fails = fails + 1
		end
	end

	-- never leave a stash empty because of unlucky rolls
	if (n_items == 0) then
		local fallback = {"food","medicine","ammo","tool"}
		for i=1,#fallback do
			if (try_add(fallback[i],0)) then
				break
			end
		end
	end

	-- personal flavor item
	if (n_items > 0 and math.random(100) <= FLAVOR_CHANCE) then
		local sec = FLAVOR_ITEMS[math.random(#FLAVOR_ITEMS)]
		if (not used[sec] and ini:section_exist(sec)) then
			entries[#entries+1] = sec
		end
	end

	if (DEV_DEBUG) then
		printf("coc_treasure_manager: box=%s level=%s theme=%s tier=%s items=%s",tostring(se_box.id),tostring(lname),theme.id,tier.name,table.concat(entries,","))
	end

	return entries, theme, tier
end

local function addon_bit(ini, sec, line, bit, chance)
	local st = ini:r_float_ex(sec,line)
	if (not st or st <= 0) then
		return 0
	end
	if (st == 1) then
		return bit
	end
	if (math.random(100) <= chance) then
		return bit
	end
	return 0
end

local function apply_weapon_data(se_obj, sec, ini, cond)
	local data = stpk_utils.get_weapon_data(se_obj)
	if not (data) then
		return
	end

	-- random addons, only the ones this weapon really supports
	local flag = 0
	flag = flag + addon_bit(ini,sec,"scope_status",1,35)
	flag = flag + addon_bit(ini,sec,"grenade_launcher_status",2,20)
	flag = flag + addon_bit(ini,sec,"silencer_status",4,20)

	-- random ammo type
	local ammos = alun_utils.parse_list(ini,sec,"ammo_class")
	local ct = ammos and #ammos or 0
	local ammo_type = ct > 0 and math.random(0,ct-1) or 0

	data.addon_flags = flag
	data.ammo_type = ammo_type
	data.condition = cond and (cond/100) or ((math.random(70)+30)/100)
	stpk_utils.set_weapon_data(data,se_obj)
end

-- Spawns stored entries inside the box (parent = box id)
local function spawn_entries(id, pos, lvid, gvid, list)
	local ini = system_ini()
	local sim = alife()

	for i=1,#list do
		local sec, count, cond = parse_entry(list[i])
		if (sec ~= "" and ini:section_exist(sec)) then
			if (utils.is_ammo(sec)) then
				create_ammo(sec,pos,lvid,gvid,id,count or math.random(10,30))
			else
				for n=1,(count or 1) do
					-- since we spawning on parent, we don't want to register object or packetdata will be inaccurate
					local se_obj = sim:create(sec,pos,0,0,id,false)
					if (se_obj) then
						local cls = se_obj:clsid()
						if (IsWeapon(nil,cls) and cls ~= clsid.wpn_knife_s) then
							apply_weapon_data(se_obj,sec,ini,cond)
						elseif (cond) then
							pcall(function() se_obj.condition = cond / 100 end)
						end
						-- because we didn't register, we do it now, manually
						alife():register(se_obj)
					end
				end
			end
		else
			printf("coc_treasure_manager.script: invalid section %s",sec)
		end
	end
end

------------------------------------------------------------------------------------------------------------------
--							PRIVATE: callbacks
------------------------------------------------------------------------------------------------------------------
local function on_game_load()
	if (caches_count > 0) then
		return
	end

	local sim = alife()
	for i=1, 65534 do
		local se_obj = sim:object(i)
		if (se_obj) then
			if (IsInvbox(nil,se_obj:clsid())) then
				caches[se_obj.id] = false
				caches_count = caches_count + 1
			end
		end
	end

	for i=1, math.floor(caches_count/2) do
		create_random_stash(true,"stash")
	end
end

local function actor_on_item_take_from_box(box,itm)
	if (caches[box:id()] == true) then
		caches[box:id()] = false
		local hud = get_hud()
		if (hud and box:is_inv_box_empty()) then
			hud:HideActorMenu()
		end
		level.map_remove_object_spot(box:id(), "treasure")
		xr_statistic.inc_counter("stashes_found")
		news_manager.send_treasure(1)
	end
end

local function save_state(data)
	if (caches_count <= 0) then
		return
	end

	if not (data.coc_treasure_manager) then
		data.coc_treasure_manager = {}
	end

	data.coc_treasure_manager.caches_count = caches_count
	data.coc_treasure_manager.caches = caches
end

local function load_state(data)
	if not (data.coc_treasure_manager) then
		return
	end

	caches_count = data.coc_treasure_manager.caches_count or caches_count
	caches = data.coc_treasure_manager.caches or caches

	data.coc_treasure_manager.caches_count = nil
	data.coc_treasure_manager.caches = nil
end

local function physic_object_on_use_callback(box,who)
	if (IsInvbox(box)) then
		try_spawn_treasure(box)
	end
end
------------------------------------------------------------------------------------------------------------------
--							ON GAME START
------------------------------------------------------------------------------------------------------------------
function on_game_start()
	RegisterScriptCallback("on_game_load",on_game_load)
	RegisterScriptCallback("actor_on_item_take_from_box",actor_on_item_take_from_box)
	RegisterScriptCallback("save_state",save_state)
	RegisterScriptCallback("load_state",load_state)
	RegisterScriptCallback("physic_object_on_use_callback",physic_object_on_use_callback)
end

-------------------------------------------------------------------------------------------------------------------
--							PUBLIC
-------------------------------------------------------------------------------------------------------------------
last_secret = nil

-- Picks a free box and fills it with generated loot (spawned when the box is opened)
-- no_spot: don't add a map spot, hint: map spot hint, bonus_items: table of sections that are always added
function create_random_stash(no_spot,hint,bonus_items)
	last_secret = nil

	if (caches_count <= 0) then
		return
	end

	last_secret = true

	local sim = alife()

	-- create a temporary table to use math.random
	local t = {}
	for id,v in pairs(caches) do
		-- false means box is available
		if (v == false) then
			table.insert(t,id)
		end
	end

	local index = #t > 0 and math.random(#t)
	if not (index) then
		return
	end

	local id = t[index]
	local se_box = id and sim:object(id)
	if not (se_box) then
		caches[id] = nil
		caches_count = caches_count - 1
		return
	end

	local entries = generate_loot(se_box,0,bonus_items)

	if (#entries > 0) then
		-- create map spot
		if (no_spot ~= true and level.map_has_object_spot(id,"treasure") == 0) then
			level.map_add_object_spot_ser(id, "treasure", hint or "")
			news_manager.send_treasure(0)
		end
		caches[id] = table.concat(entries,",")
	else
		caches[id] = false
	end
end


-- ////////////////////////////////////////////////////////////////////////////////////////////////
--
-- drx_create_random_stash function
--
-- ------------------------------------------------------------------------------------------------
--
--	Description:
--		- Creates a random stash and fills it immediately
--
--	Usage:
--		drx_create_random_stash( no_spot, hint, bonus_items, bonus_lottery )
--
--	Parameters:
--		no_spot
--			- true: don't create a map spot
--		hint
--			- map spot hint
--		bonus_items
--			- table of item sections that are always put into the stash (inventory boxes only)
--		bonus_lottery
--			- luck bonus; every point shifts the tier roll towards richer stashes
--
--	Return value (type: number):
--		ID of the stash
--
-- ------------------------------------------------------------------------------------------------
--	Modified by DoctorX
--	for DoctorX Questlines 1.6
--	Last modified October 20, 2016
-- ------------------------------------------------------------------------------------------------

function drx_create_random_stash( no_spot, hint, bonus_items, bonus_lottery )

	last_secret = nil

	if ( caches_count <= 0 ) then
		return
	end

	last_secret = true

	local sim = alife( )

	-- Create a temporary table to use math.random:
	local t = {}
	for id, v in pairs( caches ) do

		-- False means box is available:
		if ( v == false ) then
			if ( bonus_items ) then

				-- This feature only works with inventory boxes:
				local se_box = id and sim:object( id )
				if ( se_box and se_box:clsid( ) == clsid.inventory_box_s ) then
					table.insert( t, id )
				end

			else
				table.insert( t, id )

			end

		end

	end

	local index = #t > 0 and math.random( #t )
	if not ( index ) then
		return
	end

	local id = t[index]
	local se_box = id and sim:object( id )
	if not ( se_box ) then
		caches[id] = nil
		caches_count = (caches_count - 1)
		return
	end

	if ( se_box:clsid( ) ~= clsid.inventory_box_s ) then
		if ( se_box:spawn_ini( ) and se_box:spawn_ini( ):section_exist( "drop_box" ) ) then

			-- Create map spot:
			if ( no_spot ~= true and level.map_has_object_spot( id, "treasure" ) == 0 ) then
				level.map_add_object_spot_ser( id, "treasure", hint or "" )
				news_manager.send_treasure( 0 )
			end

			-- Switch cache true, indicating it has treasure:
			caches[id] = true

			-- This is handled by xr_box.script:
			return

		else  -- invalid object
			caches[id] = nil
			caches_count = caches_count - 1
			return

		end
	end

	-- Switch cache true, indicating it has treasure:
	caches[id] = true

	-- Create map spot:
	if ( no_spot ~= true and level.map_has_object_spot( id, "treasure" ) == 0 ) then
		level.map_add_object_spot_ser( id, "treasure", hint or "" )
		news_manager.send_treasure( 0 )
	end

	math.random()
	math.random()
	math.random()

	local entries = generate_loot( se_box, bonus_lottery or 0, bonus_items )
	spawn_entries( id, se_box.position, se_box.m_level_vertex_id, se_box.m_game_vertex_id, entries )

	return id

end

-- \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\


function try_spawn_treasure(box)
	local id = box:id()

	if not (caches[id]) then
		return
	end

	if not (type(caches[id]) == "string") then
		return
	end

	local spawned_item = alun_utils.str_explode(caches[id],",")
	caches[id] = true

	spawn_entries(id,box:position(),box:level_vertex_id(),box:game_vertex_id(),spawned_item)
end

function save(pk)
	if (USE_MARSHAL) then
		return
	end
	pk:w_u16(caches_count)
	for id,v in pairs(caches) do
		pk:w_u16(id)
		pk:w_bool(v)
	end
end

function load(pk)
	if (USE_MARSHAL) then
		return
	end
	caches_count = pk:r_u16()
	for i=1,caches_count do
		caches[pk:r_u16()] = pk:r_bool()
	end
end

function get_valid_item_sections()
	local t = {}
	local ini = system_ini()
	ini:section_for_each(function(section)
		if not (ltx:line_exist("ignore_sections",section)) then
			if (ini:line_exist(section,"cform")) then
				if (ini:r_bool_ex(section,"can_trade",true) == true) then
					if (ini:r_bool_ex(section,"quest_item",false) == false) then
						if not (string.find(section,"mp_")) then
							local name = ini:r_string_ex(section,"inv_name")
							if (name and name ~= "" and name ~= "default") then
								local cost = ini:r_float_ex(section,"cost") or 0
								if (cost > 0) then
									t[section] = cost
								end
							end
						end
					end
				end
			end
		end
	end
	)

	-- List of all items in game that are not quest items
	if (DEV_DEBUG_DEV) then
		local cfg = io.open("valid_item_sections.ltx","w+")
		for k,v in pairs(t) do
			cfg:write(k.."\n")
		end
		cfg:close()
	end
	return t
end
