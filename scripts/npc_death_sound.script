-- возвращение озвучки смерти НПС by av661194 (Fixed & Optimized)

local playing_sounds = {} -- Сюда сохраняем играющие звуки, чтобы их не удалял Garbage Collector

local function npc_on_death_callback(victim)
    local actor = db.actor
    if not actor then return end

    local pos = actor:position()
    local npc_pos = victim:position()
    
    -- Ограничение по дистанции (если далеко, то и не паримся)
    if pos:distance_to(npc_pos) > 30 then
        return
    end

    -- Очищаем таблицу от уже отыгравших звуков, чтобы не забивать память игры
    for id, snd_obj in pairs(playing_sounds) do
        if not snd_obj:playing() then
            playing_sounds[id] = nil
        end
    end

    local community = victim:character_community()
    
    -- Получаем точный префикс озвучки из профиля конкретного НПС (например, "characters_voice\\human_01\\stalker\\")
