[af_rusty_sea_violet]:af_base
GroupControlSection                      = spawn_group
$spawn                                   = "artifacts\rusty sea-urchin_violet"
$npc                                     = on	                                       ; option for Level Editor
;$prefetch 		= 3
cform                                    = skeleton
class                                    = ARTEFACT

