description                              = st_af_rusty_sea_urchin_violet_descr
inv_name                                 = af_rusty_sea_urchin_violet
inv_name_short                           = af_rusty_sea_urchin_violet
inv_weight                               = 0.5

inv_grid_x                               = 4
inv_grid_y                               = 1

cost                                     = 12000
jump_height                              = .7

