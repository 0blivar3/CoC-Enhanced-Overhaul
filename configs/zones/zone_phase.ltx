[zone_phase_rift]:zone_base
GroupControlSection	= spawn_group_zone
$spawn 			= "zones\phase_rift"
$def_sphere = 2
$prefetch 		= 16
class			= ZS_MBALD

hit_impulse_scale	= 4.0
effective_radius	= 1.15
actor_blowout_radius_percent = 0.85

ef_anomaly_type		= 1
ef_weapon_type		= 13

postprocess		= mosquito_bald    ; грави-искажение

; --- Смешанный урон ---
hit_type		= shock   ; электрический основной

max_start_power		= 1.1
attenuation		= 0.85

; -------- Партиклы (из других аномалий) --------

; idle из грави
idle_particles		        = anomaly2\bold_idle

; blowout из электры
blowout_particles	        = anomaly2\electra2_blast

; грави-дым
idle_small_particles	    = anomaly2\gravity_damage_01_smoke
idle_big_particles	        = anomaly2\gravity_damage_02_smoke

; электрический вход
entrance_small_particles	= anomaly2\electra_entrance_small
entrance_big_particles	    = anomaly2\emi_entrance_big_00

; микс ударных эффектов
hit_small_particles		    = anomaly2\electra_entrance_small
hit_big_particles		    = anomaly2\gravity_damage_02_blood2

; -------- Звук (микс) --------

idle_sound		    = anomaly\gravi_rumble2
blowout_sound	    = anomaly\electra_blast1
hit_sound		    = anomaly\electra_hit
entrance_sound	    = anomaly\anomaly_gravy_hit1

; -------- Тайминги --------

awaking_time		= 150
accamulate_time		= 1200
blowout_time		= 500

disable_time		= 200
disable_time_small	= 400
disable_idle_time	= 200

ignore_nonalive		= false
ignore_small		= false
ignore_artefacts	= true

; -------- Свет --------

blowout_light		= on
light_color		    = 0.6,0.7,1.2
light_range		    = 35.0
light_time 		    = 1.0
light_height		= 2.0

idle_light			= off

; -------- Ветер (от грави) --------

blowout_wind		= on
blowout_wind_time_start = 0
blowout_wind_time_peak  = 200
blowout_wind_time_end   = 450
blowout_wind_power		= 0.6

shape_transp_color		= 150, 100, 255, 70
shape_edge_color		= 50, 50, 100, 255

