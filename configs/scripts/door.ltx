[logic]
active = ph_door@close

[ph_door@unlocked]
locked = false
closed = true
snd_open_start = trader_door_locked
on_use = ph_door@open

[ph_door@close]
locked = false
closed = true
snd_open_start = trader_door_locked
on_use = ph_door@open

[ph_door@open]
locked = false
closed = false
snd_close_start = trader_door_locked
on_use = ph_door@close